rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isAdmin()    { return isSignedIn() && request.auth.token.admin == true; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    // Catalogo: lectura publica, escritura solo admin.
    match /products/{id} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // Promociones: mismo criterio que el catalogo.
    match /promociones/{id} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // Perfiles: cada uno ve y edita el suyo.
    //
    // No existe un campo `role` en el modelo de datos: hay exactamente dos
    // roles y se derivan del token. Con el claim `admin` sos soporte/dueno;
    // sin el claim sos comprador. El usuario no completa nada.
    // La prohibicion de escribir `role` es defensa en profundidad: si algun
    // dia alguien reintroduce ese campo desde el cliente, se rechaza.
    match /users/{uid} {
      allow read:   if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && !('role' in request.resource.data);
      allow update: if isAdmin() ||
                       (isOwner(uid)
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));
      allow delete: if isAdmin();
    }

    // Pedidos: cada cliente ve los suyos; el admin ve todos.
    // El `create` del cliente es TEMPORAL — en el subproyecto B pasa a
    // `if false` y la escritura queda solo en manos del Admin SDK, que es
    // lo que permite revalidar precios y stock del lado del servidor.
    // Las reglas no pueden revalidar precios: exigiria un get() por item
    // y el limite son 10 lecturas por evaluacion.
    match /compras/{id} {
      allow read:   if isAdmin() ||
                       (isSignedIn() && resource.data.buyer.uid == request.auth.uid);
      // `date` es obligatorio: obtenerTodasLasCompras ordena por el y
      // Firestore omite en silencio los documentos que no lo tienen, asi que
      // un pedido sin date le muestra "compra exitosa" al cliente y queda
      // invisible en el panel para siempre.
      // `buyer.email` tiene que coincidir con el del token porque el
      // subproyecto C va a mandar ahi el mail del pedido.
      allow create: if isSignedIn()
                    && request.resource.data.keys().hasOnly(['buyer', 'items', 'total', 'date'])
                    && request.resource.data.buyer.uid == request.auth.uid
                    && request.resource.data.buyer.email == request.auth.token.email
                    && request.resource.data.total is number
                    && request.resource.data.total >= 0
                    && request.resource.data.items is list
                    && request.resource.data.items.size() > 0
                    && request.resource.data.items.size() <= 50
                    && request.resource.data.date is string
                    && request.resource.data.date.size() <= 40;
      allow update, delete: if isAdmin();
    }

    // Mensajes de contacto: cualquiera escribe (el formulario es publico),
    // solo el admin lee. Exigir login perderia consultas de gente que
    // todavia no se registro; el limite de tamanio acota el spam hasta que
    // haya rate limiting en api/contacto.
    //
    // `hasOnly` no es cosmetico: sin el, limitar solo `mensaje` dejaba que
    // cualquiera sin sesion escribiera documentos de ~1 MiB en un campo
    // inventado, cobrados a Max, hasta reventar la bandeja (que ademas se
    // lee sin limit()). Cada string va acotado, no solo el cuerpo.
    // `date` es obligatorio porque obtenerMensajes ordena por el y Firestore
    // omite en silencio los documentos que no tienen el campo del orderBy.
    match /mensajes/{id} {
      allow read: if isAdmin();
      allow create: if request.resource.data.keys()
                         .hasOnly(['nombre', 'email', 'direccion', 'ciudad', 'mensaje', 'date', 'leido'])
                    && request.resource.data.mensaje is string
                    && request.resource.data.mensaje.size() <= 2000
                    && request.resource.data.email is string
                    && request.resource.data.email.size() <= 200
                    && request.resource.data.date is string
                    && request.resource.data.date.size() <= 40
                    && (!('nombre' in request.resource.data)
                        || request.resource.data.nombre.size() <= 120)
                    && (!('direccion' in request.resource.data)
                        || request.resource.data.direccion.size() <= 200)
                    && (!('ciudad' in request.resource.data)
                        || request.resource.data.ciudad.size() <= 120);
      allow update, delete: if isAdmin();
    }

    // Default: negar. Una coleccion nueva nace cerrada, no abierta.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
