{"nodes": [{"id": "readme_ecommerce_react", "label": "Ecommerce React - Proyecto Final", "file_type": "document", "source_file": "README.md", "source_location": "L1-L3", "source_url": "https://github.com/maxdrag0/react-coder", "captured_at": null, "author": null, "contributor": null, "rationale": "Framed as a React final project: Firebase is chosen as a realtime backend so the project needs no custom server, and the feature set is the canonical ecommerce rubric (catalog, filter, detail, cart, checkout, contact)."}, {"id": "readme_catalogo_de_productos", "label": "Catalogo de Productos", "file_type": "concept", "source_file": "README.md", "source_location": "L9", "source_url": "https://github.com/maxdrag0/react-coder", "captured_at": null, "author": null, "contributor": null, "rationale": "Items render dynamically from Firestore rather than from a bundled static list, so the catalog can change without a redeploy."}, {"id": "readme_filtrado_por_categoria", "label": "Filtrado por Categoria", "file_type": "concept", "source_file": "README.md", "source_location": "L10", "source_url": "https://github.com/maxdrag0/react-coder", "captured_at": null, "author": null, "contributor": null, "rationale": "Filtering is expressed as category ROUTES instead of local component state, which makes a filtered view linkable, shareable and back-button friendly at the cost of a navigation round trip."}, {"id": "readme_detalle_de_producto", "label": "Detalle de Producto", "file_type": "concept", "source_file": "README.md", "source_location": "L11", "source_url": "https://github.com/maxdrag0/react-coder", "captured_at": null, "author": null, "contributor": null, "rationale": "Stock is enforced at the detail view through a quantity counter, pushing the stock ceiling to the point of add-to-cart rather than validating it later at checkout."}, {"id": "readme_carrito_de_compras", "label": "Carrito de Compras", "file_type": "concept", "source_file": "README.md", "source_location": "L12", "source_url": "https://github.com/maxdrag0/react-coder", "captured_at": null, "author": null, "contributor": null, "rationale": "Cart state is global via Context API instead of prop drilling or an external store (Redux/Zustand), keeping the dependency surface small while letting any route read the cart."}, {"id": "readme_checkout", "label": "Checkout", "file_type": "concept", "source_file": "README.md", "source_location": "L13", "source_url": "https://github.com/maxdrag0/react-coder", "captured_at": null, "author": null, "contributor": null, "rationale": "The order id is generated by Firebase on document creation rather than by the client, so the backend owns uniqueness and the confirmation screen simply echoes the returned id."}, {"id": "readme_formulario_de_contacto", "label": "Formulario de Contacto", "file_type": "concept", "source_file": "README.md", "source_location": "L14", "source_url": "https://github.com/maxdrag0/react-coder", "captured_at": null, "author": null, "contributor": null, "rationale": "Messages are written straight to the database instead of through an email/SMTP service, which removes any server-side dependency but means nobody is notified unless the database is inspected."}, {"id": "readme_firebase", "label": "Firebase", "file_type": "concept", "source_file": "README.md", "source_location": "L3,L21", "source_url": "https://github.com/maxdrag0/react-coder", "captured_at": null, "author": null, "contributor": null, "rationale": "Used as a realtime backend-as-a-service so the project ships with no custom API layer; products, purchase orders and contact messages all live in the same hosted store."}, {"id": "readme_firestore", "label": "Firestore Database", "file_type": "concept", "source_file": "README.md", "source_location": "L9,L21", "source_url": "https://github.com/maxdrag0/react-coder", "captured_at": null, "author": null, "contributor": null, "rationale": "Document/collection store acting as the single source of truth for items, orders and messages; its collections are the shared data contract between otherwise unconnected features."}, {"id": "readme_react", "label": "React.js (Hooks, Context API, Router)", "file_type": "concept", "source_file": "README.md", "source_location": "L20", "source_url": "https://github.com/maxdrag0/react-coder", "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "readme_context_api", "label": "Context API Global State", "file_type": "rationale", "source_file": "README.md", "source_location": "L12,L20", "source_url": "https://github.com/maxdrag0/react-coder", "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen as the global-state mechanism for the cart because it is built into React: no extra library, no store boilerplate. Trade-off accepted: every consumer re-renders on any cart change, acceptable at this catalog size."}, {"id": "readme_react_router_dom", "label": "React Router Dom", "file_type": "concept", "source_file": "README.md", "source_location": "L22", "source_url": "https://github.com/maxdrag0/react-coder", "captured_at": null, "author": null, "contributor": null, "rationale": "Client-side routing is what makes category filtering and product detail addressable URLs inside a single-page app shell."}, {"id": "readme_react_spinners", "label": "React Spinners", "file_type": "concept", "source_file": "README.md", "source_location": "L23", "source_url": "https://github.com/maxdrag0/react-coder", "captured_at": null, "author": null, "contributor": null, "rationale": "Added specifically to cover the async gap of Firestore fetches: because data arrives after first paint, every data-backed view needs a visible loading state."}, {"id": "readme_instalacion_local", "label": "Instalacion y Configuracion Local", "file_type": "document", "source_file": "README.md", "source_location": "L28-L36", "source_url": "https://github.com/maxdrag0/react-coder", "captured_at": null, "author": null, "contributor": null, "rationale": "Setup instructions are truncated after the clone step: no dependency install, no dev-server command and no Firebase credential/config step, so the documented procedure cannot produce a running app."}], "edges": [{"source": "readme_ecommerce_react", "target": "readme_react", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L3,L20", "weight": 1.0}, {"source": "readme_ecommerce_react", "target": "readme_firebase", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L3,L21", "weight": 1.0}, {"source": "readme_ecommerce_react", "target": "readme_react_router_dom", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L22", "weight": 1.0}, {"source": "readme_ecommerce_react", "target": "readme_react_spinners", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L23", "weight": 1.0}, {"source": "readme_firebase", "target": "readme_firestore", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L21", "weight": 1.0}, {"source": "readme_catalogo_de_productos", "target": "readme_firestore", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L9", "weight": 1.0}, {"source": "readme_checkout", "target": "readme_firebase", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L13", "weight": 1.0}, {"source": "readme_carrito_de_compras", "target": "readme_context_api", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L12", "weight": 1.0}, {"source": "readme_context_api", "target": "readme_react