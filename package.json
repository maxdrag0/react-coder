{
  "name": "lavadero-ecommerce",
  "homepage": "https://maxdrag0.github.io/react-coder",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "test": "npm run test:unit && npm run test:rules",
    "test:unit": "vitest run tests/unit",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-lavadero \"vitest run tests/rules\"",
    "set-admin": "node scripts/set-admin.mjs",
    "seed": "node scripts/seed-productos.mjs",
    "categorias": "node scripts/normalizar-categorias.mjs",
    "marcas": "node scripts/normalizar-marcas.mjs"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "bootstrap": "^5.3.8",
    "firebase": "^12.6.0",
    "lucide-react": "^1.21.0",
    "react": "^19.2.3",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.9.6",
    "react-spinners": "^0.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "firebase-admin": "^13.10.0",
    "firebase-tools": "^14.27.0",
    "gh-pages": "^6.3.0",
    "globals": "^16.4.0",
    "jsdom": "^26.1.0",
    "vite": "^7.1.7",
    "vitest": "^3.2.7"
  }
}
